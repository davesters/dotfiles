export ZSH=$HOME/.dotfiles
export PROJECTS=$HOME/projects
export GOPATH=$HOME/projects/go
export ANDROID_HOME=$HOME/Library/Android/sdk
export JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
export EDITOR='code --wait'

# Machine-local env and secrets; not tracked.
[[ -f ~/.localrc ]] && source ~/.localrc

typeset -U path fpath
path=(
  $HOME/.local/bin
  $GOPATH/bin
  "/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
  $ANDROID_HOME/cmdline-tools/latest/bin
  $ANDROID_HOME/platform-tools
  $ANDROID_HOME/emulator
  $HOME/software/flutter/bin
  $path
)
fpath=($ZSH/functions ${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh/site-functions $fpath)

config_files=($ZSH/*/*.zsh)
for file in ${config_files:#*/completion.zsh}; do source $file; done

autoload -Uz compinit && compinit

for file in ${(M)config_files:#*/completion.zsh}; do source $file; done
unset config_files file

eval "$(mise activate zsh)"
eval "$(starship init zsh)"

### MANAGED BY RANCHER DESKTOP START (DO NOT EDIT)
export PATH="/Users/davidc/.rd/bin:$PATH"
### MANAGED BY RANCHER DESKTOP END (DO NOT EDIT)
